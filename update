#!/bin/bash
set -eo pipefail
trap "exit" INT

# Pull upstream changes
echo -e "\033[0;32m====>\033[0m Pull origin..."
git pull

echo -e "\033[0;32m====>\033[0m Initial check..."

# Get current release name
CURRENT_RELEASE=$(sed -n 's#^ARG N8N_VERSION="\([^"]*\)".*#\1#p' Dockerfile)
CURRENT_RUNNERS_RELEASE=$(sed -n 's#^ARG N8N_VERSION="\([^"]*\)".*#\1#p' Dockerfile.runners)

if [ "$CURRENT_RELEASE" != "$CURRENT_RUNNERS_RELEASE" ]; then
  echo -e "\033[0;31mERROR:\033[0m Dockerfile and Dockerfile.runners use different n8n versions."
  exit 1
fi

# Get the latest stable 2.x.x release name
RELEASE=$(curl -s https://api.github.com/repos/n8n-io/n8n/releases?per_page=100 \
  | jq -r '[.[] | select((.draft | not) and (.prerelease | not)) | .tag_name | sub("^n8n@"; "") | select(test("^2\\.[0-9]+\\.[0-9]+$"))] | sort_by(split(".") | map(tonumber)) | last')

if [ -z "$RELEASE" ] || [ "$RELEASE" = "null" ]; then
  echo -e "\033[0;31mERROR:\033[0m Could not find a stable n8n 2.x release."
  exit 1
fi

# Exit script if already up to date
if [ "$RELEASE" = "$CURRENT_RELEASE" ]; then
  echo -e "\033[0;32m=>\033[0m Already up to date..."
  exit 0
fi

# Replace N8N_VERSION in both Dockerfiles with the new release
sed -i "s#ARG N8N_VERSION.*#ARG N8N_VERSION=\"${RELEASE}\"#" Dockerfile
sed -i "s#ARG N8N_VERSION.*#ARG N8N_VERSION=\"${RELEASE}\"#" Dockerfile.runners

# Replace README link to n8n release
N8N_BADGE="[![n8n](https://img.shields.io/badge/n8n-${RELEASE}-blue.svg)](https://github.com/n8n-io/n8n/releases/tag/n8n%40${RELEASE})"
sed -i "s#\[\!\[n8n\].*#${N8N_BADGE}#" README.md

# Push changes
git add Dockerfile Dockerfile.runners README.md
git commit -m "Update to n8n version ${RELEASE}"
git push origin master

# Create tag
git tag $RELEASE
git push --tags
